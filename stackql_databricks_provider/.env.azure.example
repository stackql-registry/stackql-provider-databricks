# Azure Databricks - copy to .env.azure and fill in (gitignored).
# A Databricks-managed service principal with the account admin role on the
# Azure Databricks account (accounts.azuredatabricks.net), OAuth M2M. Entra ID
# tokens are not used.
#
#   make smoke CLOUD=azure      # reads .env.azure

export DATABRICKS_CLOUD=azure
export DATABRICKS_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
export DATABRICKS_CLIENT_ID=00000000-0000-0000-0000-000000000000
export DATABRICKS_CLIENT_SECRET=dose...

# Optional. The workspace deployment name is the host prefix of the workspace
# URL (adb-1234567890123456.7.azuredatabricks.net -> adb-1234567890123456.7);
# when unset the smoke harness derives it from
# databricks_account.provisioning.workspaces.
# export DATABRICKS_DEPLOYMENT_NAME=adb-1234567890123456.7
# export DATABRICKS_METASTORE_ID=

# Optional override of the account console host (bare host, no scheme);
# wins over DATABRICKS_CLOUD.
# export DATABRICKS_ACCOUNT_HOST=accounts.azuredatabricks.net
