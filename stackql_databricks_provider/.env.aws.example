# Databricks on AWS - copy to .env.aws (or .env, the default) and fill in.
# Both files are gitignored. A Databricks-managed service principal with the
# account admin role, OAuth M2M: the same variables Terraform and the
# Databricks CLI use.
#
#   make smoke CLOUD=aws        # reads .env.aws
#   make smoke                  # reads .env (aws is the provider default)

export DATABRICKS_CLOUD=aws
export DATABRICKS_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
export DATABRICKS_CLIENT_ID=00000000-0000-0000-0000-000000000000
export DATABRICKS_CLIENT_SECRET=dose...

# Optional. The workspace deployment name is the host prefix of the workspace
# URL (dbc-abcd0123-a1bc.cloud.databricks.com -> dbc-abcd0123-a1bc); when unset
# the smoke harness derives it from databricks_account.provisioning.workspaces.
# export DATABRICKS_DEPLOYMENT_NAME=dbc-abcd0123-a1bc
# export DATABRICKS_METASTORE_ID=

# Optional override of the account console host (bare host, no scheme).
# export DATABRICKS_ACCOUNT_HOST=accounts.cloud.databricks.com
